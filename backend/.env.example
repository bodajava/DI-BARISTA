PORT=3001
APPLICATION_NAME="DIBARESTA CAFFE"
NODE_ENV=development
API_PREFIX=api/v1

# Browser origins allowed to call the API (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:3000
# Number of proxy hops in front of the API (Next.js server = 1)
TRUST_PROXY=1

# Database (MongoDB / MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/dibaresta_caffe
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dibaresta_caffe

# Cache (Upstash Redis with TLS)
REDIS_URI=rediss://default:<password>@<host>.upstash.io:6379

# Security & Tokens
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# All four token signatures must be different. The server refuses to start with weak/default values.
ENCRYPTION_KEY=<random-48-bytes>
# ENCRYPTION_KEY_LEGACY=<previous key, only while migrating old data>
USER_ACCESS_TOKE_SIGNATURE=<random-48-bytes>
USER_REFRISH_TOKE_SIGNATURE=<random-48-bytes>
SYSTEM_ACCESS_TOKE_SIGNATURE=<random-48-bytes>
SYSTEM_REFRISH_TOKE_SIGNATURE=<random-48-bytes>

ACCESS_EXPIRE_IN_DEV=1d
REFRESH_EXPIRE_IN_DEV=1d
ACCESS_EXPIRE_IN_PROD=15m
REFRESH_EXPIRE_IN_PROD=7d

# Super Admin Seeder Defaults
SUPER_ADMIN_NAME="DIBARESTA Super Admin"
SUPER_ADMIN_EMAIL=admin@dibarestacaffe.com
# At least 12 characters; only used the first time, when no Super Admin exists
SUPER_ADMIN_PASSWORD=<strong-unique-password>
SUPER_ADMIN_PHONE=+201000000000

# Google Client ID
CLIENT_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com

# AWS S3 Storage
# File uploads (product photos). Default "local": saved on this server's disk, no cloud cost.
STORAGE_DRIVER=local
# Absolute folder OUTSIDE the code folder, so redeploys don't delete uploaded photos
UPLOAD_DIR=/home/USER/dibarista-uploads

# Only if STORAGE_DRIVER=s3 (Amazon S3 or any S3-compatible bucket)
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# AWS_S3_ENDPOINT=

# Nodemailer / SMTP
EMAIL_APP=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Payment Gateways (Stripe Mock/Dev)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLIC_KEY=pk_test_replace_me

# Paymob Payment Gateway
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_IFRAME_ID=your-card-iframe-id
PAYMOB_PUBLIC_KEY=egy_pk_test_replace_me
PAYMOB_SECRET_KEY=egy_sk_test_replace_me
PAYMOB_CURRENCY=EGP
PAYMOB_HMAC_SECRET=replace_with_paymob_hmac_secret
PAYMOB_INTEGRATION_ID_CARD=your-card-integration-id
PAYMOB_INTEGRATION_ID_WALLET=replace_with_wallet_integration_id

# AI Integration (Gemini 2.5 Flash & WhatsApp Support Handoff)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
SUPPORT_WHATSAPP_NUMBER=201000000000

# Public storefront address; Paymob payment returns are forwarded here (/checkout/complete)
STOREFRONT_URL=http://localhost:3000

# Paymob: "unified" (default) or "legacy" (card iframe)
PAYMOB_CHECKOUT_MODE=unified
# Paymob hosted Unified Checkout page
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/
# Public URL of this API (Paymob webhook + redirect are built from it)
API_PUBLIC_URL=https://api.your-domain.com
# Inbox for new-order and contact-form alerts
ADMIN_NOTIFY_EMAIL=orders@your-domain.com
# Sender shown on emails
MAIL_FROM="DI BARISTA <your-email@gmail.com>"
